# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI agent)
ANTHROPIC_API_KEY=

# 46elks (telefoni/SMS)
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
ELKS_PHONE_NUMBER=

# Google OAuth (kalender + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Måste matcha EXAKT en redirect-URI registrerad i Google Cloud Console
# (OAuth-klientens "Authorized redirect URIs") och peka på
# /api/google/callback, t.ex. https://app.handymate.se/api/google/callback
GOOGLE_REDIRECT_URI=

# Push notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Resend (e-post fallback)
RESEND_API_KEY=

# Stripe (betalningar)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cron secret
CRON_SECRET=

# ─── Driftsynlighet (2026-09-01) ─────────────────────────
# Sentry — felspårning på server + klient. Tomt = helt av (no-op).
# Klienten läser NEXT_PUBLIC_SENTRY_DSN, servern SENTRY_DSN (fallback till
# den publika). AUTH_TOKEN/ORG/PROJECT behövs bara för källkarte-uppladdning
# vid bygget; utan token byggs det precis som förut.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Kreditbevakningen (/api/cron/credit-watch, lib/observability/credit-watch.ts):
# larmmejl vid warn/error (default andreas@handymate.se), SMS vid error via
# HANDYMATE_SUPPORT_ALERT_PHONES (kommaseparerade E.164-nummer — samma som
# supporteskaleringen). Gräns för 46elks-saldot i kr (default 300).
OPS_ALERT_EMAIL=
HANDYMATE_SUPPORT_ALERT_PHONES=
CREDIT_WATCH_ELKS_MIN_SEK=300

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Flaggat presentationslager för onboardingen. Lämna false/otilldelad i
# produktion tills färsk-konto- och mobilbeviset är godkänt. Den klassiska
# wizarden finns alltid kvar och samma API-/sparvägar används i båda lägena.
NEXT_PUBLIC_SETUP_STUDIO_ENABLED=false

# Dedicated demo environment — leave BOTH unset everywhere else.
# The server reset gate and public presenter gate use the same business ID.
DEMO_BUSINESS_ID=
NEXT_PUBLIC_DEMO_BUSINESS_ID=

# ─── Fortnox bokföring ───────────────────────────────────
# Aktiveras när Fortnox Developer Portal-konto är skapat.
# Redirect-URI:n ägs av koden (app/api/integrations/fortnox/connect + callback,
# hårdkodad till /api/integrations/fortnox/callback) — ingen env-variabel behövs;
# samma URI ska vara registrerad hos Fortnox.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

# ─── Partner-referrals ────────────────────────────────────
# API-nyckel för leadsbyrå-partner (POST /api/partners/referral)
PARTNER_API_KEY=

# ─── Launch Desk — kostnadsmätning på brief-anropet (pass 1b) ─────
# business_config.id för Handymates EGET "husföretag", om ett sådant finns.
# lib/launch-desk/brief.ts bokför Anthropic-kostnaden för
# POST /api/admin/launch/brief mot detta businessId (meterDirectLlmCall)
# bara när variabeln är satt — fail-soft, annars mäts anropet inte alls
# (gissar aldrig ett businessId).
HANDYMATE_HOUSE_BUSINESS_ID=
