# Endast en disponibel Supabase-testmiljö. Testet skapar och raderar fixtures.
TENANT_TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
TENANT_TEST_SUPABASE_ANON_KEY=
TENANT_TEST_SUPABASE_SERVICE_ROLE_KEY=

# Valfri direkt PostgreSQL-URL. Utan den körs hela authenticated/RLS-provet,
# men katalogkontrollerna för pg_proc.prosecdef och tabellgrants hoppas över.
TENANT_TEST_DATABASE_URL=postgresql://postgres.YOUR_TEST_PROJECT_REF:PASSWORD@HOST:6543/postgres
TENANT_TEST_DATABASE_SSL=require
TENANT_TEST_EXPECTED_PROJECT_REF=YOUR_TEST_PROJECT_REF

# Säkerhetsspärr. Båda företagen nedan måste vara helt disponibla: om RLS är
# trasig kan det avsiktliga cross-tenant DELETE-testet radera deras config-rad.
TENANT_TEST_ALLOW_DESTRUCTIVE_RLS_PROBE=YES_DELETE_DISPOSABLE_TENANTS

# Två riktiga Auth-konton med lösenord, vart och ett medlem i sitt eget
# disponibla företag. Företags-ID:n måste vara olika.
TENANT_A_EMAIL=
TENANT_A_PASSWORD=
TENANT_A_BUSINESS_ID=
TENANT_B_EMAIL=
TENANT_B_PASSWORD=
TENANT_B_BUSINESS_ID=
