+import { act, fireEvent, render, waitFor } from '@testing-library/react-native'
+
+const mockPush = jest.fn()
+const mockRecorder = { isRecording: false, uri: 'file:///report.m4a', prepareToRecordAsync: jest.fn(), record: jest.fn(), stop: jest.fn() }
+jest.mock('expo-router', () => ({ useRouter: () => ({ push: mockPush }) }))
+jest.mock('expo-audio', () => ({
+  AudioModule: { requestRecordingPermissionsAsync: jest.fn() }, RecordingPresets: { HIGH_QUALITY: {} },
+  useAudioRecorder: () => mockRecorder, setAudioModeAsync: jest.fn(),
+}))
+jest.mock('expo-haptics', () => ({ impactAsync: jest.fn(), notificationAsync: jest.fn(), ImpactFeedbackStyle: { Heavy: 'heavy' }, NotificationFeedbackType: { Success: 'success' } }))
+jest.mock('react-native-safe-area-context', () => ({ useSafeAreaInsets: () => ({ top: 0, left: 0, right: 0, bottom: 34 }) }))
+jest.mock('../components/AIAvatar', () => () => null)
+jest.mock('../components/VoiceRing', () => ({ __esModule: true, default: ({ state }: any) => {
+  const React = require('react'); const { Text } = require('react-native'); return React.createElement(Text, {}, state)
+} }))
+jest.mock('../lib/api', () => ({ chatWithMatte: jest.fn(), confirmMatteAction: jest.fn(), transcribeAudio: jest.fn(), getUserDisplayName: jest.fn().mockResolvedValue('Anders') }))
+jest.mock('@react-native-async-storage/async-storage', () => require('@react-native-async-storage/async-storage/jest/async-storage-mock'))
+
+import { AudioModule } from 'expo-audio'
+import { chatWithMatte, confirmMatteAction, transcribeAudio } from '../lib/api'
+import { sendToMatte, confirmPendingMatteAction, cancelPendingMatteAction } from '../lib/matte-actions'
+import { useMatteStore } from '../lib/matte-store'
+import MatteSheet from '../components/MatteSheet'
+import ProjectReportCard from '../components/ProjectReportCard'
+
+const config = { mode: 'text' as const, projectId: 'proj_a', projectName: 'Köket', workReport: true, workDate: '2026-08-31' }
+const scope = { ...config, customerId: null }
+const pending = { tool_name: 'log_time', args: {}, summary: 'Anders · Köket · 2026-08-31\nLägg till 4 h', confirm_label: 'Lägg till tiden', token: 'signed-token' }
+const reply = { reply: 'Hur länge jobbade du?', messages: [{ agent: 'lars', content: 'Hur länge jobbade du?' }], current_agent: 'lars', thread_id: 'thread_a', action: null }
+function deferred<T>() { let resolve!: (v: T) => void; const promise = new Promise<T>(r => { resolve = r }); return { promise, resolve } }
+
+beforeEach(() => {
+  jest.clearAllMocks()
+  useMatteStore.getState().clearMessages()
+  ;(chatWithMatte as jest.Mock).mockReset().mockResolvedValue(reply)
+  ;(confirmMatteAction as jest.Mock).mockReset()
+  ;(AudioModule.requestRecordingPermissionsAsync as jest.Mock).mockReset().mockResolvedValue({ granted: true })
+  mockRecorder.prepareToRecordAsync.mockResolvedValue(undefined)
+  mockRecorder.stop.mockResolvedValue(undefined)
+  mockRecorder.isRecording = false
+})
+
+test('project card opens real sheet in voice or text mode without executing anything', () => {
+  const onOpen = jest.fn()
+  const ui = render(<ProjectReportCard projectId="proj_a" projectName="Köket" onOpen={onOpen} />)
+  fireEvent.press(ui.getByLabelText('Rapportera dagens arbete med röst'))
+  expect(onOpen).toHaveBeenLastCalledWith(expect.objectContaining({ mode: 'voice', projectId: 'proj_a', projectName: 'Köket', workReport: true, workDate: expect.stringMatching(/^\d{4}-\d{2}-\d{2}$/) }))
+  fireEvent.press(ui.getByText('Skriv istället'))
+  expect(onOpen.mock.calls[1][0].mode).toBe('text')
+  expect(chatWithMatte).not.toHaveBeenCalled()
+})
+test('sheet to full-chat continuation retains exact project, date and thread', async () => {
+  await sendToMatte({ content: 'Monterat skåp', ...config })
+  await sendToMatte({ content: 'Fyra timmar' })
+  expect((chatWithMatte as jest.Mock).mock.calls[1][0].context).toMatchObject({ workReport: true, projectId: 'proj_a', workDate: '2026-08-31', threadId: 'thread_a' })
+  expect((chatWithMatte as jest.Mock).mock.calls[1][0].messages).toHaveLength(3)
+})
+test('project/date change discards previous messages and thread, never sends them to another project', async () => {
+  await sendToMatte({ content: 'HEMLIGT PROJEKT A', ...config })
+  await sendToMatte({ content: 'Projekt B', ...config, projectId: 'proj_b', workDate: '2026-08-30' })
+  const body = (chatWithMatte as jest.Mock).mock.calls[1][0]
+  expect(body.context.threadId).toBeUndefined(); expect(body.messages).toEqual([{ role: 'user', content: 'Projekt B' }])
+})
+test('pending card blocks sending and switching project', async () => {
+  useMatteStore.getState().setScope(scope)
+  useMatteStore.getState().setPendingConfirmation(pending)
+  await expect(sendToMatte({ content: 'Mer' })).rejects.toThrow(/Bekräfta/)
+  expect(() => useMatteStore.getState().setScope({ ...scope, projectId: 'b' })).toThrow(/Bekräfta/)
+  expect(chatWithMatte).not.toHaveBeenCalled()
+})
+test('late response from abandoned scope is not displayed under the next project', async () => {
+  const d = deferred<any>(); (chatWithMatte as jest.Mock).mockReturnValue(d.promise)
+  const send = sendToMatte({ content: 'A', ...config })
+  useMatteStore.getState().setScope({ ...scope, projectId: 'b' })
+  d.resolve({ ...reply, pending_confirmation: pending }); await send
+  expect(useMatteStore.getState().messages).toEqual([])
+  expect(useMatteStore.getState().pendingConfirmation).toBeNull()
+})
+test('network uncertainty restores exact token; second card is not auto-executed', async () => {
+  useMatteStore.getState().setScope(scope); useMatteStore.getState().setPendingConfirmation(pending)
+  ;(confirmMatteAction as jest.Mock).mockRejectedValueOnce(new Error('Network lost')).mockResolvedValueOnce({ ...reply, pending_confirmation: { ...pending, token: 'second-token', tool_name: 'add_work_note' } })
+  await expect(confirmPendingMatteAction()).rejects.toThrow('Network lost')
+  expect(useMatteStore.getState().pendingConfirmation?.token).toBe('signed-token')
+  await confirmPendingMatteAction()
+  expect((confirmMatteAction as jest.Mock).mock.calls).toEqual([['signed-token'], ['signed-token']])
+  expect(useMatteStore.getState().pendingConfirmation?.token).toBe('second-token')
+  cancelPendingMatteAction()
+  expect(useMatteStore.getState().messages.at(-1)?.content).toContain('Tidigare sparade poster påverkas inte')
+  expect(confirmMatteAction).toHaveBeenCalledTimes(2)
+})
+test('cannot send another request while a confirmation is executing', async () => {
+  useMatteStore.getState().setScope(scope); useMatteStore.getState().setPendingConfirmation(pending)
+  const d = deferred<any>(); (confirmMatteAction as jest.Mock).mockReturnValue(d.promise)
+  const confirm = confirmPendingMatteAction()
+  await expect(sendToMatte({ content: 'Mer' })).rejects.toThrow(/arbetar/)
+  await expect(confirmPendingMatteAction()).rejects.toThrow(/Vänta/)
+  d.resolve(reply); await confirm
+  expect(confirmMatteAction).toHaveBeenCalledTimes(1)
+})
+test('permission denial offers text fallback in same project', async () => {
+  ;(AudioModule.requestRecordingPermissionsAsync as jest.Mock).mockResolvedValue({ granted: false })
+  const ui = render(<MatteSheet config={{ ...config, mode: 'voice' }} onClose={jest.fn()} />)
+  await ui.findByText('Mikrofonbehörighet krävs')
+  fireEvent.press(ui.getByText('Skriv istället'))
+  fireEvent.changeText(ui.getByLabelText('Meddelande till Matte'), 'Fyra timmar, skåp')
+  fireEvent.press(ui.getByText('Skicka till Matte'))
+  await ui.findByText('Hur länge jobbade du?')
+  expect((chatWithMatte as jest.Mock).mock.calls[0][0].context).toMatchObject({ projectId: 'proj_a', workReport: true })
+  expect(mockRecorder.record).not.toHaveBeenCalled()
+})
+test('permission arriving after sheet closes does not start microphone', async () => {
+  const d = deferred<any>(); (AudioModule.requestRecordingPermissionsAsync as jest.Mock).mockReturnValue(d.promise)
+  const ui = render(<MatteSheet config={{ ...config, mode: 'voice' }} onClose={jest.fn()} />)
+  ui.rerender(<MatteSheet config={null} onClose={jest.fn()} />)
+  await act(async () => { d.resolve({ granted: true }); await d.promise })
+  expect(mockRecorder.record).not.toHaveBeenCalled()
+})
+test('transcript is editable before sending; card uses server facts and only clicks execute', async () => {
+  ;(transcribeAudio as jest.Mock).mockResolvedValue('Två timmar felhört')
+  ;(chatWithMatte as jest.Mock).mockResolvedValue({ ...reply, reply: '', messages: [], pending_confirmation: pending })
+  ;(confirmMatteAction as jest.Mock).mockResolvedValue({ ...reply, reply: 'Tiden sparad', messages: [{ agent: 'lars', content: 'Tiden sparad' }] })
+  const ui = render(<MatteSheet config={{ ...config, mode: 'voice' }} onClose={jest.fn()} />)
+  await ui.findByText('listening')
+  fireEvent.press(ui.getByText('listening'))
+  await waitFor(() => expect(ui.getByLabelText('Meddelande till Matte').props.value).toBe('Två timmar felhört'))
+  expect(chatWithMatte).not.toHaveBeenCalled()
+  fireEvent.changeText(ui.getByLabelText('Meddelande till Matte'), 'Fyra timmar, monterat skåp')
+  fireEvent.press(ui.getByText('Skicka till Matte'))
+  await ui.findByText(pending.summary)
+  expect((chatWithMatte as jest.Mock).mock.calls[0][0].messages.at(-1).content).toBe('Fyra timmar, monterat skåp')
+  expect(confirmMatteAction).not.toHaveBeenCalled()
+  fireEvent.press(ui.getByText('Lägg till tiden'))
+  await ui.findByText('Tiden sparad')
+  expect(confirmMatteAction).toHaveBeenCalledWith('signed-token')
+})
+test('changed report date still renders the first reply after scope reset', async () => {
+  useMatteStore.getState().setScope(scope)
+  useMatteStore.getState().appendMessage({ role: 'user', content: 'Gammalt' })
+  useMatteStore.getState().appendMessage({ role: 'assistant', content: 'Gammalt svar' })
+  const ui = render(<MatteSheet config={config} onClose={jest.fn()} />)
+  fireEvent.changeText(ui.getByLabelText('Rapportdatum'), '2026-08-30')
+  fireEvent.changeText(ui.getByLabelText('Meddelande till Matte'), 'Jobbade igår')
+  fireEvent.press(ui.getByText('Skicka till Matte'))
+  await ui.findByText('Hur länge jobbade du?')
+  expect((chatWithMatte as jest.Mock).mock.calls[0][0].context.workDate).toBe('2026-08-30')
+})
+test('reopening same report with pending card shows it without starting microphone', async () => {
+  useMatteStore.getState().setScope(scope); useMatteStore.getState().setPendingConfirmation(pending)
+  const ui = render(<MatteSheet config={{ ...config, mode: 'voice' }} onClose={jest.fn()} />)
+  await ui.findByText(pending.summary)
+  expect(AudioModule.requestRecordingPermissionsAsync).not.toHaveBeenCalled()
+})
+test('opening another project does not show the first projects pending card under the wrong header', async () => {
+  useMatteStore.getState().setScope(scope); useMatteStore.getState().setPendingConfirmation(pending)
+  const ui = render(<MatteSheet config={{ ...config, projectId: 'proj_b', projectName: 'Badrummet' }} onClose={jest.fn()} />)
+  await ui.findByText('Bekräfta eller avbryt det väntande kortet i chatten först.')
+  expect(ui.queryByText(pending.summary)).toBeNull()
+  fireEvent.press(ui.getByText('Fortsätt i chatten'))
+  expect(mockPush).toHaveBeenCalledWith('/matte')
+  expect(useMatteStore.getState().scope?.projectId).toBe('proj_a')
+})
